# Dependencies
node_modules
src/web/node_modules

# Lockfile — the image regenerates it so platform-specific optional deps
# resolve for linux (see the npm install step in the Dockerfile). It has to be
# excluded here too, or the later `COPY . .` puts the host's copy back over the
# freshly generated one; the restored lockfile then disagrees with the
# installed tree and `npm prune` dies resolving the workspace links with
# "Cannot read properties of undefined (reading 'extraneous')".
package-lock.json

# Build output (will be rebuilt in container)
dist

# Data directories (should be mounted as volumes)
data
uploads
*.db
*.db-wal
*.db-shm

# Git
.git
.gitignore

# Documentation (not needed in container)
*.md
!README.md
docs/

# Logs
logs
*.log

# Environment files (secrets should be passed via env vars)
.env*
!.env.example

# Deployment configs (not needed inside container)
docker-compose*.yml
Dockerfile*
fly.toml
render.yaml
railway.toml
railway.json
ecosystem.config.js
deploy/

# Development
coverage
.nyc_output
.vscode
.idea
*.swp
*.swo
.DS_Store

# Tests
**/*.test.ts
**/*.spec.ts
__tests__
