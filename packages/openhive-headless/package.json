{
  "name": "openhive-headless",
  "version": "0.1.1",
  "description": "Headless OpenHive hub — Fastify server + MAP hub, no web UI. Runs in `mode: server`.",
  "homepage": "https://github.com/alexngai/openhive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/openhive.git",
    "directory": "packages/openhive-headless"
  },
  "author": "Alex Ngai",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    }
  },
  "bin": {
    "openhive-headless": "./bin/openhive-headless.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "node scripts/copy-dist.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "openhive",
    "headless",
    "agents",
    "fastify",
    "self-hosted",
    "map-hub"
  ],
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.49",
    "@aws-sdk/client-s3": "^3.980.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@libsql/client": "^0.14.0",
    "@lydell/node-pty": "^1.2.0-beta.3",
    "@multi-agent-protocol/sdk": "^0.1.12",
    "agent-iam": "^0.0.2",
    "agent-inbox": "^0.2.3",
    "agent-workspace": "^0.1.7",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.8.0",
    "cognitive-core": "^0.2.5",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "fastify": "^5.0.0",
    "git-cascade": "^0.0.7",
    "jose": "^6.1.3",
    "js-yaml": "^4.1.1",
    "macro-agent": "^0.2.3",
    "marked": "^17.0.1",
    "mime-types": "^3.0.2",
    "minimem": "^0.1.0",
    "nanoid": "^5.0.9",
    "nodemailer": "^7.0.13",
    "openhive-types": "^0.2.0",
    "@swarmkit-ai/swarm-runner": "^0.1.18",
    "opentasks": "^0.1.3",
    "pg": "^8.18.0",
    "sharp": "^0.34.5",
    "skill-tree": "^0.2.0",
    "skill-tree-indexer": "^0.2.2",
    "swarm-dispatch": "^0.3.5",
    "swarmcraft": "^0.1.15",
    "swarmkit": "^0.1.0",
    "turndown": "^7.2.4",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.19.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@slack/socket-mode": "^2.0.5",
    "@slack/web-api": "^7.14.1"
  }
}
