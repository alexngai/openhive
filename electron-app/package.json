{
  "name": "openhive-electron",
  "version": "0.1.3",
  "description": "Electron desktop shell for OpenHive",
  "homepage": "https://github.com/alexngai/openhive",
  "author": {
    "name": "Alex Ngai",
    "email": "alexander.s.ngai@gmail.com"
  },
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "build:icons": "node scripts/build-icons.mjs",
    "start": "electron dist/main.js",
    "dev": "npm --prefix .. run build && npm run build && npm run start",
    "dist": "npm --prefix .. run build && npm run build && npm run build:icons && node scripts/stage-openhive.mjs && node scripts/prune-node-modules.mjs && electron-builder",
    "postinstall": "node scripts/fix-better-sqlite3.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "openhive": "file:.."
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "electron": "^37.10.3",
    "electron-builder": "^26.8.1",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.openhive.desktop",
    "productName": "OpenHive",
    "electronVersion": "37.10.3",
    "directories": {
      "output": "../release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alexngai",
        "repo": "openhive"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "build/icon.png",
      "build/logo-transparent.png",
      "build/tray-iconTemplate.png",
      "build/tray-iconTemplate@2x.png",
      "!data/**",
      "!logs/**",
      "!uploads/**",
      "!.openhive/**",
      "!.swarm/**",
      "!src/**",
      "!scripts/**",
      "!tsconfig*",
      "!CLAUDE.md",
      "!README*",
      "!build/entitlements*",
      "!build/icon.icns",
      "!**/*.db",
      "!**/*.db-shm",
      "!**/*.db-wal",
      "!**/iam-secret.key",
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "**/*",
          "!**/openhive-electron/data/**",
          "!**/openhive-electron/node_modules/**",
          "!**/openhive-electron/src/**",
          "!**/openhive-electron/scripts/**",
          "!**/openhive-electron/build/**",
          "!**/openhive-electron/tsconfig*",
          "!**/*.db",
          "!**/*.db-shm",
          "!**/*.db-wal",
          "!**/iam-secret.key",
          "!**/electron/**",
          "!**/electron-builder*/**",
          "!**/electron-winstaller/**",
          "!**/@electron/**",
          "!**/app-builder-bin/**",
          "!**/app-builder-lib/**",
          "!**/dmg-builder/**",
          "!**/dmg-license/**",
          "!**/builder-util*/**",
          "!**/7zip-bin/**",
          "!**/typescript/**",
          "!**/tsup/**",
          "!**/tsx/**",
          "!**/vite/**",
          "!**/@vitejs/**",
          "!**/vitest/**",
          "!**/@vitest/**",
          "!**/jsdom/**",
          "!**/@testing-library/**",
          "!**/tailwindcss/**",
          "!**/@tailwindcss/**",
          "!**/claude-code-swarm/**",
          "!**/sessionlog/**",
          "!**/esbuild/**",
          "!**/@esbuild/**",
          "!**/rollup/**",
          "!**/@rollup/**",
          "!**/@swc/**",
          "!**/@types/**",
          "!**/@babel/**",
          "!**/lightningcss*/**",
          "!**/react/**",
          "!**/react-dom/**",
          "!**/react-router-dom/**",
          "!**/react-router/**",
          "!**/@tiptap/**",
          "!**/lowlight/**",
          "!**/highlight.js/**",
          "!**/@tanstack/**",
          "!**/react-markdown/**",
          "!**/rehype-highlight/**",
          "!**/remark-gfm/**",
          "!**/rehype-*/**",
          "!**/remark-*/**",
          "!**/lucide-react/**",
          "!**/react18-json-view/**",
          "!**/boring-avatars/**",
          "!**/@dnd-kit/**",
          "!**/zustand/**",
          "!**/clsx/**",
          "!**/graphology*/**",
          "!**/sigma/**",
          "!**/dagre*/**",
          "!**/cytoscape*/**",
          "!**/planck/**",
          "!**/date-fns/**",
          "!**/mermaid/**",
          "!**/three/**",
          "!**/node-llama-cpp/**",
          "!**/@opentelemetry/**",
          "!**/react-syntax-highlighter/**",
          "!**/@jimp/**",
          "!**/jimp/**",
          "!**/@opentui/**",
          "!**/@solid*/**",
          "!**/solid-js/**",
          "!**/@reflink/**",
          "!**/bun-webgpu-*/**",
          "!**/swarmcraft/public/**",
          "!**/swarmcraft/src/**",
          "!**/swarmcraft/docs/**",
          "!**/swarmcraft/dist/ui/**",
          "!**/swarmcraft/vite*",
          "!**/swarmcraft/vitest*",
          "!**/swarmcraft/tsconfig*",
          "!**/macro-agent/src/**",
          "!**/macro-agent/docs/**",
          "!**/macro-agent/mvp_docs/**",
          "!**/macro-agent/test_fixtures/**",
          "!**/macro-agent/scripts/**",
          "!**/openswarm/src/**",
          "!**/openswarm/docs/**",
          "!**/openswarm/scripts/**",
          "!**/*.md",
          "!**/*.markdown",
          "!**/CLAUDE.md",
          "!**/{test,tests,__tests__,__mocks__,powered-test}/**",
          "!**/{example,examples,demo,demos,sample,samples,doc,docs}/**",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.ts.map",
          "!**/*.d.mts",
          "!**/*.d.cts",
          "!**/.github/**",
          "!**/.husky/**",
          "!**/.nyc_output/**",
          "!**/CHANGELOG*",
          "!**/HISTORY*",
          "!**/MIGRATION*",
          "!**/tsconfig*.json",
          "!**/tsconfig.tsbuildinfo",
          "!**/.eslintrc*",
          "!**/.prettierrc*",
          "!**/.editorconfig",
          "!**/.npmignore",
          "!**/*.test.js",
          "!**/*.spec.js",
          "!**/*.test.mjs",
          "!**/*.spec.mjs",
          "!**/bun.lock",
          "!**/bun.lockb",
          "!**/pnpm-lock.yaml",
          "!**/yarn.lock",
          "!**/postject/**",
          "!**/node-gyp/**",
          "!**/@malept/**",
          "!**/flatpak-bundler/**",
          "!**/@develar/**",
          "!**/openhive/dist/web/wasm/**"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bcrypt/**",
      "node_modules/sharp/**",
      "node_modules/@lydell/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "artifactName": "OpenHive-mac-${arch}.${ext}",
      "icon": "build/icon.icns",
      "identity": "Alexander Ngai (TKJJVX3QDY)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "files": [
        "!**/vendor/ripgrep/arm64-linux/**",
        "!**/vendor/ripgrep/arm64-win32/**",
        "!**/vendor/ripgrep/x64-darwin/**",
        "!**/vendor/ripgrep/x64-linux/**",
        "!**/vendor/ripgrep/x64-win32/**",
        "!**/node_modules/@openswarm/cli-linux-*/**",
        "!**/node_modules/@openswarm/cli-win32-*/**",
        "!**/node_modules/@openswarm/cli-darwin-x64/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "OpenHive-linux-${arch}.${ext}",
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Alex Ngai <alexander.s.ngai@gmail.com>",
      "files": [
        "!**/vendor/ripgrep/arm64-darwin/**",
        "!**/vendor/ripgrep/arm64-win32/**",
        "!**/vendor/ripgrep/x64-darwin/**",
        "!**/vendor/ripgrep/x64-win32/**",
        "!**/node_modules/@openswarm/cli-darwin-*/**",
        "!**/node_modules/@openswarm/cli-win32-*/**"
      ]
    }
  }
}
