{
  "name": "openhive-electron",
  "version": "0.1.0",
  "description": "Electron desktop shell for OpenHive",
  "homepage": "https://github.com/alexngai/openhive",
  "author": {
    "name": "Alex Ngai",
    "email": "alexander.s.ngai@gmail.com"
  },
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "build:icons": "node scripts/build-icons.mjs",
    "start": "electron dist/main.js",
    "dev": "npm --prefix .. run build && npm run build && npm run start",
    "dist": "npm --prefix .. run build && npm run build && npm run build:icons && node scripts/stage-openhive.mjs && electron-builder",
    "postinstall": "node scripts/fix-better-sqlite3.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "openhive": "file:.."
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "electron": "^37.10.3",
    "electron-builder": "^26.8.1",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.openhive.desktop",
    "productName": "OpenHive",
    "electronVersion": "37.10.3",
    "directories": {
      "output": "../release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alexngai",
        "repo": "openhive"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "**/*",

          "!electron/**", "!electron-builder*/**", "!electron-winstaller/**",
          "!@electron/**", "!app-builder-bin/**", "!app-builder-lib/**",
          "!dmg-builder/**", "!dmg-license/**", "!builder-util*/**",

          "!typescript/**", "!tsup/**", "!tsx/**",
          "!vite/**", "!@vitejs/**", "!vitest/**", "!@vitest/**",
          "!jsdom/**", "!@testing-library/**",
          "!tailwindcss/**", "!@tailwindcss/**",
          "!claude-code-swarm/**", "!sessionlog/**",
          "!esbuild/**", "!rollup/**", "!@rollup/**",
          "!@swc/**", "!@types/**",

          "!react/**", "!react-dom/**", "!react-router-dom/**",
          "!@tiptap/**", "!lowlight/**", "!highlight.js/**",
          "!@tanstack/react-query/**",
          "!react-markdown/**", "!rehype-highlight/**", "!remark-gfm/**",
          "!lucide-react/**", "!react18-json-view/**", "!boring-avatars/**",
          "!@dnd-kit/**", "!zustand/**", "!clsx/**",
          "!graphology*/**", "!sigma/**", "!dagre*/**",
          "!date-fns/**", "!mermaid/**", "!three/**", "!node-llama-cpp/**",
          "!@opentelemetry/**",

          "!**/*.md", "!**/*.markdown",
          "!**/{test,tests,__tests__,__mocks__,powered-test}/**",
          "!**/{example,examples,demo,demos,sample,samples,doc,docs}/**",
          "!**/*.map", "!**/*.d.ts", "!**/*.d.ts.map",
          "!**/.github/**", "!**/.husky/**", "!**/.nyc_output/**",
          "!**/CHANGELOG*", "!**/HISTORY*", "!**/MIGRATION*",
          "!**/tsconfig*.json", "!**/tsconfig.tsbuildinfo",
          "!**/.eslintrc*", "!**/.prettierrc*",
          "!**/*.test.js", "!**/*.spec.js"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bcrypt/**",
      "node_modules/sharp/**",
      "node_modules/@lydell/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "icon": "build/icon.icns",
      "identity": "Alexander Ngai (TKJJVX3QDY)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Alex Ngai <alexander.s.ngai@gmail.com>"
    }
  }
}
