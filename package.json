{
  "name": "openhive",
  "version": "0.1.7",
  "description": "Lightweight control plane for agent swarms",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    }
  },
  "bin": {
    "openhive": "./bin/openhive.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "workspaces": [
    "electron-app",
    "packages/openhive-headless"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup",
    "build:web": "node src/web/ensure-wasm.mjs && vite build --config src/web/vite.config.ts",
    "build:headless": "npm run build:server && npm -w openhive-headless run build",
    "dev": "tsx watch --exclude '.git/**' --exclude '.swarm/**' --exclude '.openhive/**' --exclude '.sessionlog/**' --exclude 'references/**' src/cli.ts serve",
    "dev:web": "vite --config src/web/vite.config.ts",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:server": "vitest run --project server",
    "test:server:watch": "vitest --project server",
    "test:web": "vitest run --project web",
    "test:web:watch": "vitest --project web",
    "lint": "eslint src --ext .ts",
    "deps:check": "syncpack lint",
    "deps:check:all": "syncpack lint --source package.json --source 'electron-app/package.json' --source 'packages/*/package.json' --source 'references/*/package.json'",
    "deps:fix": "syncpack fix",
    "prepublishOnly": "npm run build && publint"
  },
  "keywords": [
    "ai",
    "agents",
    "social-network",
    "api",
    "fastify",
    "self-hosted"
  ],
  "author": "Alex Ngai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/openhive.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.49",
    "@aws-sdk/client-s3": "^3.980.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@libsql/client": "^0.14.0",
    "@lydell/node-pty": "^1.2.0-beta.3",
    "@multi-agent-protocol/sdk": "^0.1.12",
    "agent-iam": "^0.0.2",
    "agent-inbox": "^0.2.3",
    "agent-workspace": "^0.1.7",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.8.0",
    "cognitive-core": "^0.2.5",
    "commander": "^14.0.2",
    "fastify": "^5.0.0",
    "git-cascade": "^0.0.7",
    "git-url-parse": "^16.1.0",
    "jose": "^6.1.3",
    "js-yaml": "^4.1.1",
    "macro-agent": "^0.2.3",
    "mime-types": "^3.0.2",
    "minimem": "^0.1.0",
    "nanoid": "^5.0.9",
    "nodemailer": "^7.0.13",
    "openhive-types": "^0.2.0",
    "openswarm": "^0.1.17",
    "opentasks": "^0.1.3",
    "openteams": "^0.3.1",
    "openteams-editor": "^0.1.1",
    "pg": "^8.18.0",
    "sharp": "^0.34.5",
    "skill-tree": "^0.2.0",
    "skill-tree-indexer": "^0.2.2",
    "swarm-dispatch": "^0.3.5",
    "swarmcraft": "^0.1.13",
    "swarmkit": "^0.1.0",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.19.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@slack/socket-mode": "^2.0.5",
    "@slack/web-api": "^7.14.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@sigma/edge-curve": "^3.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/extension-code-block-lowlight": "^3.22.3",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-table-of-contents": "^3.22.4",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.17.14",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.7.0",
    "boring-avatars": "^2.0.4",
    "buffer": "^6.0.3",
    "claude-code-swarm": "^0.3.21",
    "clsx": "^2.1.1",
    "cronstrue": "^3.14.0",
    "date-fns": "^4.1.0",
    "ghostty-web": "^0.4.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "isomorphic-git": "^1.36.1",
    "jsdom": "^28.1.0",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "openteams-editor": "^0.1.1",
    "publint": "^0.3.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3",
    "react-syntax-highlighter": "^16.1.0",
    "react18-json-view": "^0.2.9",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sessionlog": "^0.0.6",
    "sigma": "^3.0.2",
    "syncpack": "^15.1.2",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turndown": "^7.2.4",
    "typescript": "^5.7.3",
    "unified": "^11.0.5",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "zustand": "^4.5.7"
  }
}
